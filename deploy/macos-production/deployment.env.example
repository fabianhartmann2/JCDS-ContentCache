# Copy outside the Git checkout or provide these values through the managed
# launch environment. This file contains no Jamf credential.
JCDS_MAC_PROD_IMAGE_TAG=production
JCDS_MAC_PROD_LISTEN_IP=0.0.0.0
JCDS_MAC_PROD_LISTEN_PORT=8443
JCDS_MAC_PROD_HELPER_ENV_FILE=/Users/REPLACE/JCDS-ContentCache-runtime/cache-helper.production.env
JCDS_MAC_PROD_TLS_DIR=/Users/REPLACE/JCDS-ContentCache-runtime/tls

# Cache lifecycle. Go duration syntax is used; 2160h equals 90 days.
JCDS_CACHE_RETENTION=2160h
JCDS_CACHE_CLEANUP_INTERVAL=15m
JCDS_CACHE_CLEANUP_TRIGGER_FREE_PERCENT=30
JCDS_CACHE_CLEANUP_TARGET_FREE_PERCENT=35
JCDS_ACCESS_INDEX_FLUSH_INTERVAL=30s

# Optional webhook monitoring. These values are used only when the additional
# compose.monitoring.yaml file is included. Keep the HMAC secret outside Git.
JCDS_METRICS_WEBHOOK_URL=https://monitoring.example.invalid/jcds-cache
JCDS_METRICS_WEBHOOK_ALLOWED_HOSTS=monitoring.example.invalid
JCDS_METRICS_WEBHOOK_ALLOW_PRIVATE_IPS=false
JCDS_METRICS_WEBHOOK_INTERVAL=60s
JCDS_METRICS_WEBHOOK_TIMEOUT=10s
JCDS_METRICS_WEBHOOK_MAX_ATTEMPTS=3
JCDS_METRICS_WEBHOOK_AUTH_MODE=hmac
JCDS_METRICS_RUNTIME_DIR=/Users/REPLACE/JCDS-ContentCache-runtime/monitoring
JCDS_METRICS_INSTANCE_NAME=JCDS Cache Production
JCDS_METRICS_INSTANCE_UUID=
JCDS_METRICS_INSTANCE_FQDN=jcds-cache.appfruit.ch
JCDS_METRICS_INSTANCE_VERSION=unknown
JCDS_METRICS_INSTANCE_COMMIT=unknown
JCDS_METRICS_PACKAGE_INVENTORY=summary
JCDS_METRICS_PACKAGE_INVENTORY_MAX_ITEMS=5000
JCDS_METRICS_TLS_WARNING_BEFORE=720h
JCDS_METRICS_TLS_CRITICAL_BEFORE=336h
