# Copy this file outside the Git checkout, set mode 0600, and replace every
# value marked REPLACE. Never commit the completed file.
LISTEN_ADDR=:8080
STORE_ROOT=/srv/jamf-store/packages
TEMP_ROOT=/srv/jamf-store/.temporary

JAMF_TOKEN_URL=https://REPLACE-TENANT.jamfcloud.com/api/oauth/token
JAMF_CLIENT_ID=REPLACE
JAMF_CLIENT_SECRET='REPLACE'
JAMF_CATALOG_URL=https://REPLACE-TENANT.jamfcloud.com/api/v1/jcds/files
JAMF_RESOLVER_URL_TEMPLATE=https://REPLACE-TENANT.jamfcloud.com/api/v1/jcds/files/{filename}
JAMF_DOWNLOAD_URL_FIELD=uri

# Exact hostname values only, comma-separated when more than one is approved.
# Do not include schemes, paths, signed queries, wildcards, or IP addresses.
JCDS_ALLOWED_HOSTS=REPLACE.cloudfront.net
JCDS_ALLOW_HTTP=false

TOKEN_EXPIRY_SKEW=60s
FILL_TIMEOUT=2h
SHUTDOWN_TIMEOUT=2m
MAX_PACKAGE_BYTES=26843545600
MIN_FREE_BYTES=107374182400
MIN_FREE_PERCENT=20
TEMP_FILE_MAX_AGE=24h
