# Copy this file outside the Git checkout, set mode 0600, and replace every
# value marked REPLACE. This profile contacts the real backend but publishes
# only a localhost HTTP listener for controlled testing on Docker Desktop.
LISTEN_ADDR=:8080
STORE_ROOT=/srv/jamf-store/packages
TEMP_ROOT=/srv/jamf-store/.temporary

JAMF_TOKEN_URL=https://REPLACE-TENANT.jamfcloud.com/api/oauth/token
JAMF_CLIENT_ID=REPLACE
JAMF_CLIENT_SECRET='REPLACE'
JAMF_CATALOG_URL=https://REPLACE-TENANT.jamfcloud.com/api/v1/jcds/files
JAMF_RESOLVER_URL_TEMPLATE=https://REPLACE-TENANT.jamfcloud.com/api/v1/jcds/files/{filename}
JAMF_DOWNLOAD_URL_FIELD=uri

# Exact hostname values only, comma-separated when more than one is approved.
# Do not include a scheme, path, port, signed query, wildcard, or IP address.
JCDS_ALLOWED_HOSTS=REPLACE.cloudfront.net
JCDS_ALLOW_HTTP=false

# The helper automatically clamps this margin for the observed 59-second Jamf
# token lifetime, so the token remains reusable while still refreshing early.
TOKEN_EXPIRY_SKEW=60s
FILL_TIMEOUT=2h
SHUTDOWN_TIMEOUT=2m

# Conservative Docker Desktop test limits: 5 GiB maximum package and the
# larger of 1 GiB or 10 percent free-space reserve. These are not production
# capacity values.
MAX_PACKAGE_BYTES=5368709120
MIN_FREE_BYTES=1073741824
MIN_FREE_PERCENT=10
TEMP_FILE_MAX_AGE=24h
