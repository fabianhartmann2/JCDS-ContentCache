# Copy to /etc/jcds-content-cache/deployment.env. This file contains no
# credentials; it selects host paths and the published listen address.
CACHE_IMAGE_TAG=production
CACHE_LISTEN_IP=0.0.0.0
PACKAGE_STORE_PATH=/srv/jamf-store
CACHE_HELPER_ENV_FILE=/etc/jcds-content-cache/cache-helper.env
LETSENCRYPT_ROOT=/etc/letsencrypt
