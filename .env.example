# Production values must be supplied through the approved secret/configuration platform.
LISTEN_ADDR=:8080
STORE_ROOT=/srv/jamf-store/packages
TEMP_ROOT=/srv/jamf-store/.temporary

JAMF_TOKEN_URL=https://yourserver.jamfcloud.com/api/v1/oauth/token
JAMF_CLIENT_ID=replace-me
JAMF_CLIENT_SECRET=replace-me
JAMF_CATALOG_URL=https://yourserver.jamfcloud.com/api/v1/jcds/files
JAMF_RESOLVER_URL_TEMPLATE=https://yourserver.jamfcloud.com/api/v1/jcds/files/{filename}
JAMF_DOWNLOAD_URL_FIELD=uri

# Comma-separated exact hostnames. Redirect destinations are checked against this list.
JCDS_ALLOWED_HOSTS=example.jcds.jamfcloud.com
JCDS_ALLOW_HTTP=false

TOKEN_EXPIRY_SKEW=60s
FILL_TIMEOUT=2h
SHUTDOWN_TIMEOUT=2m
MAX_PACKAGE_BYTES=26843545600

# Preserve the larger of 10 GiB or 20% of the package-store filesystem.
# A new fill is rejected before download when the package plus this reserve
# would exceed the currently available space.
MIN_FREE_BYTES=10737418240
MIN_FREE_PERCENT=20

# Incomplete .part files older than this are removed when the helper starts.
TEMP_FILE_MAX_AGE=24h
